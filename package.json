{
  "name": "@narumiruna/pi-share-viewer",
  "version": "0.1.0",
  "description": "Self-hosted Pi session viewer with interactive Mermaid diagrams",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-share-viewer.git"
  },
  "keywords": [
    "pi",
    "mermaid",
    "session-viewer"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:enhancer && vite build",
    "build:enhancer": "vite build --config vite.enhancer.config.ts",
    "dev": "npm run build:enhancer && vite",
    "preview": "vite preview",
    "check": "biome ci src tests session index.html package.json tsconfig.json playwright.config.ts vite.config.ts vite.enhancer.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run check && npm test && npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.19",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
