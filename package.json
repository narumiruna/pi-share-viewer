{
  "name": "@narumiruna/pi-share-viewer",
  "version": "0.1.0",
  "description": "Self-hosted Pi session viewer with interactive Mermaid diagrams",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-share-viewer.git"
  },
  "keywords": [
    "pi",
    "mermaid",
    "session-viewer"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "npm run build:renderer && npm run build:enhancer && vite build",
    "build:enhancer": "vite build --config vite.runtime.config.ts --mode enhancer",
    "build:renderer": "vite build --config vite.runtime.config.ts --mode renderer",
    "dev": "npm run build:renderer && npm run build:enhancer && vite",
    "preview": "vite preview",
    "check": "biome ci build src tests session index.html package.json tsconfig.json playwright.config.ts vite.config.ts vite.runtime.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run check && npm test && npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@playwright/test": "^1.62.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "mermaid": "^11.17.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "katex": "^0.16.47",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
