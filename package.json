{
  "name": "@narumiruna/pi-share-viewer",
  "version": "0.1.0",
  "description": "Self-hosted Pi session viewer with interactive Mermaid diagrams",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-share-viewer.git"
  },
  "keywords": [
    "pi",
    "mermaid",
    "session-viewer"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "npm run build:bootstrap && npm run build:renderer && npm run build:enhancer && vite build",
    "build:bootstrap": "vite build --config vite.runtime.config.ts --mode bootstrap",
    "build:enhancer": "vite build --config vite.runtime.config.ts --mode enhancer",
    "build:renderer": "vite build --config vite.runtime.config.ts --mode renderer",
    "dev": "npm run build:bootstrap && npm run build:renderer && npm run build:enhancer && vite",
    "preview": "vite preview",
    "check": "biome ci build src tests package.json tsconfig.json playwright.config.ts vite.config.ts vite.runtime.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@playwright/test": "^1.65.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "mermaid": "^12.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12",
      "undici": "8.12.3"
    }
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "katex": "^0.19.1",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
