{
  "name": "@narumiruna/pi-share-viewer",
  "version": "0.1.0",
  "description": "Self-hosted Pi session viewer with interactive Mermaid diagrams",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-share-viewer.git"
  },
  "keywords": [
    "pi",
    "mermaid",
    "session-viewer"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "npm run build:bootstrap && npm run build:renderer && npm run build:enhancer && vite build",
    "build:bootstrap": "vite build --config vite.runtime.config.ts --mode bootstrap",
    "build:enhancer": "vite build --config vite.runtime.config.ts --mode enhancer",
    "build:renderer": "vite build --config vite.runtime.config.ts --mode renderer",
    "dev": "npm run build:bootstrap && npm run build:renderer && npm run build:enhancer && vite",
    "preview": "vite preview",
    "check": "biome ci build src tests package.json tsconfig.json playwright.config.ts vite.config.ts vite.runtime.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run check && npm test && npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "mermaid": "^11.17.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "brace-expansion": "5.0.12"
    }
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
